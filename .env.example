# Copy to .env at the repository root before running Docker Compose.
# This file is only for the local Compose PostgreSQL container.
POSTGRES_DB=oasis
POSTGRES_USER=oasis
POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# Frontend is available at http://localhost:5173 by default.
WEB_PORT=5173

# Keep false only for local HTTP. Set true behind an HTTPS reverse proxy.
OASIS_COOKIE_SECURE=false
OASIS_NOTIFICATION_WORKER_ENABLED=true
