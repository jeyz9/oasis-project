# Examples only. Use a dedicated local database; never point development at production.
# Dev imports .env from the working directory as Java properties: no export or quotes.
# When launching elsewhere, set runtime OASIS_ENV_FILE to the absolute file path.
# Prod requires explicit runtime environment variables and does not import this file.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/oasis_dev
SPRING_DATASOURCE_USERNAME=oasis_dev
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
# Session cookie must be secure for HTTPS. Set false only for local HTTP development.
OASIS_COOKIE_SECURE=false
OASIS_CANCELLATION_MINUTES=120
# Durable in-app delivery; external transports remain disabled until implemented/configured.
OASIS_NOTIFICATION_WORKER_ENABLED=true
OASIS_NOTIFICATION_WORKER_DELAY_MS=10000
